<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <Platforms>x64</Platforms>
        <LangVersion>9.0</LangVersion>
        <Nullable>enable</Nullable>
        <Configurations>Release;Debug</Configurations>
    </PropertyGroup>

    <PropertyGroup>
        <ModuleName>CalradiaAtWar</ModuleName>
        <DisplayName>Calradia At War</DisplayName>
        <AssemblyName>$(ModuleName)</AssemblyName>
    </PropertyGroup>

    <!-- The module's files live at the repository root, which is the module folder in a local install.
         Anywhere else, as in the publish workflow, the build copies them into the game's Modules folder. -->
    <PropertyGroup>
        <ModuleSourceFolder>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\'))</ModuleSourceFolder>
        <ModuleTargetFolder>$([System.IO.Path]::GetFullPath('$(GameFolder)\Modules\$(ModuleName)\'))</ModuleTargetFolder>
    </PropertyGroup>

    <Target Name="CopyModule" AfterTargets="Build"
            Condition="'$(GameFolder)' != '' AND '$(ModuleSourceFolder.ToUpperInvariant())' != '$(ModuleTargetFolder.ToUpperInvariant())'">
        <ItemGroup>
            <ModuleDataFiles Include="$(ModuleSourceFolder)ModuleData\**\*" Exclude="$(ModuleSourceFolder)ModuleData\**\*.bak_*" />
            <CustomSpawnsFiles Include="$(ModuleSourceFolder)CustomSpawns\*.xml" />
        </ItemGroup>
        <Copy SourceFiles="$(ModuleSourceFolder)SubModule.xml" DestinationFolder="$(ModuleTargetFolder)" />
        <Copy SourceFiles="@(ModuleDataFiles)" DestinationFolder="$(ModuleTargetFolder)ModuleData\%(RecursiveDir)" />
        <Copy SourceFiles="@(CustomSpawnsFiles)" DestinationFolder="$(ModuleTargetFolder)CustomSpawns" />
    </Target>

</Project>
